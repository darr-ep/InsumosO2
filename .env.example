# SDD.md section 29 -- Variables de entorno
# Copiar a .env (nunca versionado, ver .gitignore) y completar valores reales
# de desarrollo/produccion.

# URL del backend PocketBase. Subdominio propuesto en la seccion 28, confirmar
# antes de aprovisionar DNS/proxy: api.insumoso2.com
VITE_POCKETBASE_URL=https://api.insumoso2.com

VITE_BUSINESS_NAME=Insumos O2
VITE_BUSINESS_PHONE=771 131 3535

# Archivo ya guardado en public/logo.png (seccion 29, no regenerar)
VITE_BUSINESS_LOGO_URL=/logo.png

# Umbral en dias para la seccion "requiere revision" del dashboard (Anexo A.3)
VITE_STALE_RENTAL_DAYS=30

# Feature: Runtime-Editable Total Stock -- total_concentradores/total_tanques
# used to be env vars here (see git history). They are now editable at
# runtime by the business owner from the Dashboard tap-to-edit dialog,
# stored in PocketBase's business_settings collection (see
# pb_migrations/*_business_settings_collection.js). No env var needed.
